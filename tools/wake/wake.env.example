# Wake settings for ONE lane (tools/wake/wake.env.example).
#
# Copy this file into this lane's own private waker directory as wake.env
# (wake.sh sources it as sh; wake.ps1 reads NAME=value lines). Replace every
# REPLACE_ value. There are no secrets here on purpose: the client config named
# below is the only credential input the waker reads.

WAKE_PYTHON=python3
WAKE_CLIENT=/REPLACE/PATH/TO/client.py
WAKE_CONFIG=/REPLACE/PATH/TO/client.local.json
WAKE_PROJECT=REPLACE_PROJECT
WAKE_ACTOR=REPLACE_ACTOR

# THE ONE WAKE COMMAND: what starts a new turn of the harness this lane runs in.
# It runs once per new fingerprint and must return; it must not run the work.
# Examples:
#   a CLI that takes a prompt:
#     WAKE_COMMAND='agent-cli --prompt "New work is ready; run your next turn."'
#   a scheduled task that starts the harness (Windows; wake.ps1 reads this file):
#     WAKE_COMMAND=schtasks /run /tn "My agent turn"
#   a desktop notification (Linux):
#     WAKE_COMMAND='notify-send "Orchestra: work is ready"'
#   the VS Code bridge already wakes its agent: that lane needs no script.
# Keep the quoting style of YOUR platform (wake.sh uses sh quoting; wake.ps1
# takes everything after "=" literally).
WAKE_COMMAND=REPLACE_WAKE_COMMAND

# Bound one wait (seconds), given to client.py wait.
WAKE_TIMEOUT=3600
# Optional poll interval; the client's own default is 300.
# WAKE_INTERVAL=300
# Optional; the default is beside the script. Use absolute paths in this file.
# wake.sh refuses a path that is empty, "/", the home directory, or an existing
# directory where a file belongs; its lock must be a lock directory of its own.
# WAKE_STATE=/REPLACE/PATH/TO/wake.state
# WAKE_LOCK=/REPLACE/PATH/TO/wake.lock
# WAKE_LOG=/REPLACE/PATH/TO/wake.log
